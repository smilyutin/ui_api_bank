{
  "name": "ui_api_bank",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "pretest": "node -e \"require('fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "test": "playwright test",
    "allure:annotate": "node scripts/annotate-allure-results.js",
    "allure:generate": "npm run allure:annotate && allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:mobile:android": "wdio run ./mobile/wdio.android.conf.ts",
    "test:mobile:ios": "wdio run ./mobile/wdio.ios.conf.ts",
    "reliability:report": "node -e \"const { createAnalyzer } = require('./helpers/flakiness-analyzer'); const a = createAnalyzer(); console.log(a.generateFormattedReport(true));\"",
    "reliability:analyze": "node scripts/analyze-reliability.js",
    "test:reliability": "playwright test tests/reliability.spec.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.5",
    "@wdio/allure-reporter": "^9.4.0",
    "@wdio/appium-service": "^9.4.0",
    "@wdio/cli": "^9.4.0",
    "@wdio/globals": "^9.4.0",
    "@wdio/local-runner": "^9.4.0",
    "@wdio/mocha-framework": "^9.4.0",
    "@wdio/spec-reporter": "^9.4.0",
    "@wdio/types": "^9.4.0",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "appium": "^2.14.0",
    "appium-uiautomator2-driver": "^3.9.0",
    "appium-xcuitest-driver": "^7.29.0",
    "expect-webdriverio": "^5.1.0",
    "ts-node": "^10.9.2",
    "webdriverio": "^9.4.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "genson-js": "^0.0.8"
  }
}
