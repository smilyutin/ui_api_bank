meta {
  name: Internal secrets (SSRF demo)
  type: http
  seq: 1
  tags: [
    internal
  ]
}

get {
  url: {{baseUrl}}/internal/secret
  body: none
  auth: inherit
}

docs {
  Returns sensitive application secrets and environment previews. Intended to be reachable only from loopback; fetch via SSRF using the URL-import endpoint.
}

example {
  name: 200 Response
  description: Secrets returned
  
  request: {
    url: {{baseUrl}}/internal/secret
    method: GET
    mode: none
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 403 Response
  description: Forbidden (non-loopback)
  
  request: {
    url: {{baseUrl}}/internal/secret
    method: GET
    mode: none
  }
  
  response: {
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
