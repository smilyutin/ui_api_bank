meta {
  name: Get transaction history
  type: http
  seq: 1
  tags: [
    transactions
  ]
}

get {
  url: {{baseUrl}}/transactions/:account_number
  body: none
  auth: inherit
}

params:path {
  account_number: 
}

docs {
  View transaction history for any account. Vulnerable to BOLA.
}

example {
  name: 200 Response
  description: Transaction list retrieved
  
  request: {
    url: {{baseUrl}}/transactions/:account_number
    method: GET
    mode: none
    params:path: {
      account_number: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "transactions": [
            {
              "id": 0,
              "from_account": "",
              "to_account": "",
              "amount": 0,
              "timestamp": ""
            }
          ]
        }
      '''
    }
  }
}
