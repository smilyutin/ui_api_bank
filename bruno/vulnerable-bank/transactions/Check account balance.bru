}

get {
  url: {{baseUrl}}/check_balance/:account_number
  body: none
  auth: inherit
}

params:path {
  account_number: 
}

docs {
  Check balance of any account. Vulnerable to BOLA.
}

example {
  name: 200 Response
  description: Balance retrieved successfully
  
  request: {
    url: {{baseUrl}}/check_balance/:account_number
    method: GET
    mode: none
    params:path: {
      account_number: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "username": "",
          "balance": 0
        }
      '''
    }
  }
}

