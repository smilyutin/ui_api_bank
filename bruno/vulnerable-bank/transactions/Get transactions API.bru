meta {
  name: Get transactions API
  type: http
  seq: 4
  tags: [
    transactions
  ]
}

get {
  url: {{baseUrl}}/api/transactions
  body: none
  auth: bearer
}

params:query {
  account_number: 
}

auth:bearer {
  token: {{token}}
}

docs {
  Get transactions for a specific account. Vulnerable to SQL injection.
}

example {
  name: 200 Response
  description: Transactions retrieved successfully
  
  request: {
    url: {{baseUrl}}/api/transactions
    method: GET
    mode: none
    params:query: {
      account_number: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "transactions": [
            {}
          ],
          "account_number": ""
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Account number required
  
  request: {
    url: {{baseUrl}}/api/transactions
    method: GET
    mode: none
    params:query: {
      account_number: 
    }
  }
  
  response: {
