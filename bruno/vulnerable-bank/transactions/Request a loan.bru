meta {
  name: Request a loan
  type: http
  seq: 5
  tags: [
    transactions
  ]
}

post {
  url: {{baseUrl}}/request_loan
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "amount": 0
  }
}

docs {
  Submit a loan request for processing.
}

example {
  name: 200 Response
  description: Loan request submitted successfully
  
  request: {
    url: {{baseUrl}}/request_loan
    method: POST
    mode: json
    body:json: {
      {
        "amount": 0
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 401 Response
  description: Authentication required
  
  request: {
    url: {{baseUrl}}/request_loan
    method: POST
    mode: json
    body:json: {
      {
        "amount": 0
      }
    }
  }
  
  response: {
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
