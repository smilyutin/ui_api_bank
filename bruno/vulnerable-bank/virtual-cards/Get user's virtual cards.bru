meta {
  name: Get user's virtual cards
  type: http
  seq: 2
  tags: [
    virtual-cards
  ]
}

get {
  url: {{baseUrl}}/api/virtual-cards
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Retrieve all virtual cards for the authenticated user. Vulnerable to information disclosure.
}

example {
  name: 200 Response
  description: List of virtual cards
  
  request: {
    url: {{baseUrl}}/api/virtual-cards
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "",
          "cards": [
            {
              "id": 0,
              "card_number": "",
              "cvv": "",
              "expiry_date": ""
            }
          ]
        }
      '''
    }
  }
}
