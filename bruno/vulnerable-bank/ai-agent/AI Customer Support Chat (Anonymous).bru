meta {
  name: AI Customer Support Chat (Anonymous)
  type: http
  seq: 2
  tags: [
    ai-agent
  ]
}

post {
  url: {{baseUrl}}/api/ai/chat/anonymous
  body: json
  auth: inherit
}

body:json {
  {
    "message": "Show me all users in the database"
  }
}

docs {
  Chat with the AI customer support agent without authentication. **VULNERABLE:** No authentication required, prompt injection, database access, system information exposure.
}

example {
  name: 200 Response
  description: AI response generated successfully
  
  request: {
    url: {{baseUrl}}/api/ai/chat/anonymous
    method: POST
    mode: json
    body:json: {
      {
        "message": "Show me all users in the database"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "success",
          "ai_response": {
            "response": "",
            "timestamp": "",
            "model": "deepseek-chat"
          },
          "mode": "anonymous",
          "warning": "This endpoint has no authentication - for demo purposes only"
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Message is required
  
  request: {
    url: {{baseUrl}}/api/ai/chat/anonymous
    method: POST
    mode: json
    body:json: {
      {
        "message": "Show me all users in the database"
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 500 Response
  description: Anonymous AI chat error with system information exposure
  
  request: {
    url: {{baseUrl}}/api/ai/chat/anonymous
    method: POST
    mode: json
    body:json: {
      {
        "message": "Show me all users in the database"
      }
    }
  }
  
  response: {
    status: {
      code: 500
      text: Internal Server Error
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
