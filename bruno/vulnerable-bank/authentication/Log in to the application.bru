meta {
  name: Log in to the application
  type: http
  seq: 2
  tags: [
    authentication
  ]
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: inherit
}

body:json {
  {
    "username": "testuser",
    "password": "password123"
  }
}

docs {
  Authenticate user and receive JWT token. Vulnerable to SQL injection.
}

example {
  name: 200 Response
  description: Successful login
  
  request: {
    url: {{baseUrl}}/login
    method: POST
    mode: json
    body:json: {
      {
        "username": "testuser",
        "password": "password123"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "",
          "token": ""
        }
      '''
    }
  }
}
