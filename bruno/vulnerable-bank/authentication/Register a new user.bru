meta {
  name: Register a new user
  type: http
  seq: 1
  tags: [
    authentication
  ]
}

post {
  url: {{baseUrl}}/register
  body: json
  auth: inherit
}

body:json {
  {
    "username": "testuser",
    "password": "password123"
  }
}

docs {
  Create a new user account. Vulnerable to BOPLA.
}

example {
  name: 200 Response
  description: Successful registration
  
  request: {
    url: {{baseUrl}}/register
    method: POST
    mode: json
    body:json: {
      {
        "username": "testuser",
        "password": "password123"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "success",
          "message": "",
          "debug_data": {}
        }
      '''
    }
  }
}
