meta {
  name: Reset password using PIN (versioned)
  type: http
  seq: 4
  tags: [
    authentication
  ]
}

post {
  url: {{baseUrl}}/api/v:version/reset-password
  body: json
  auth: inherit
}

params:path {
  version: 1
  version: 2
}

body:json {
  {
    "username": "",
    "reset_pin": "",
    "new_password": ""
  }
}

docs {
  Reset password with 3-digit PIN. Different versions have different levels of data exposure.
}

example {
  name: 200 Response
  description: Password reset successful
  
  request: {
    url: {{baseUrl}}/api/v:version/reset-password
    method: POST
    mode: json
    params:path: {
      ~version: 1
      version: 2
    }
  
    body:json: {
      {
        "username": "",
        "reset_pin": "",
        "new_password": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "",
          "message": "",
          "debug_info": {}
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid reset PIN
  
  request: {
    url: {{baseUrl}}/api/v:version/reset-password
    method: POST
    mode: json
    params:path: {
      ~version: 1
      version: 2
    }
  
    body:json: {
      {
        "username": "",
        "reset_pin": "",
        "new_password": ""
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
