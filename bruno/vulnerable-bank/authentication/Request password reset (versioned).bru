meta {
  name: Request password reset (versioned)
  type: http
  seq: 3
  tags: [
    authentication
  ]
}

post {
  url: {{baseUrl}}/api/v:version/forgot-password
  body: json
  auth: inherit
}

params:path {
  version: 1
  version: 2
}

body:json {
  {
    "username": ""
  }
}

docs {
  Generate 3-digit reset PIN. Different versions have different levels of data exposure.
}

example {
  name: 200 Response
  description: Reset PIN generated
  
  request: {
    url: {{baseUrl}}/api/v:version/forgot-password
    method: POST
    mode: json
    params:path: {
      ~version: 1
      version: 2
    }
  
    body:json: {
      {
        "username": ""
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "",
          "message": "",
          "debug_info": {}
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: User not found
  
  request: {
    url: {{baseUrl}}/api/v:version/forgot-password
    method: POST
    mode: json
    params:path: {
      ~version: 1
      version: 2
    }
  
    body:json: {
      {
        "username": ""
      }
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
