meta {
  name: Get payment history
  type: http
  seq: 4
  tags: [
    bill-payments
  ]
}

get {
  url: {{baseUrl}}/api/bill-payments/history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Retrieve user's bill payment history. Vulnerable to SQL injection and information disclosure.
}

example {
  name: 200 Response
  description: Payment history retrieved successfully
  
  request: {
    url: {{baseUrl}}/api/bill-payments/history
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "",
          "payments": [
            {
              "id": 0,
              "amount": 0,
              "payment_method": "",
              "card_number": "",
              "reference": "",
              "status": "",
              "created_at": "",
              "processed_at": "",
              "description": "",
              "biller_name": "",
              "category_name": ""
            }
          ]
        }
      '''
    }
  }
}
