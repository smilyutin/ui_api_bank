meta {
  name: Create bill payment
  type: http
  seq: 3
  tags: [
    bill-payments
  ]
}

post {
  url: {{baseUrl}}/api/bill-payments/create
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "biller_id": 1,
    "amount": 100,
    "payment_method": "balance",
    "card_id": 0,
    "description": "Monthly water bill"
  }
}

docs {
  Process a new bill payment. Multiple vulnerabilities present.
}

example {
  name: 200 Response
  description: Payment processed successfully
  
  request: {
    url: {{baseUrl}}/api/bill-payments/create
    method: POST
    mode: json
    body:json: {
      {
        "biller_id": 1,
        "amount": 100,
        "payment_method": "balance",
        "card_id": 0,
        "description": "Monthly water bill"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "status": "",
          "message": "",
          "payment_details": {
            "reference": "",
            "amount": 0,
            "payment_method": "",
            "card_id": 0,
            "timestamp": "",
            "processed_by": ""
          }
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid payment details or insufficient funds
  
  request: {
    url: {{baseUrl}}/api/bill-payments/create
    method: POST
    mode: json
    body:json: {
      {
        "biller_id": 1,
        "amount": 100,
        "payment_method": "balance",
        "card_id": 0,
        "description": "Monthly water bill"
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}
